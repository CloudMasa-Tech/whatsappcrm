# ============================================================
# wacrm QR gateway — environment
#
# Copy to .env and fill in. Every variable here is required except
# where noted; the process refuses to start with any of them missing,
# rather than coming up in a half-configured state.
# ============================================================

# HTTP port this service listens on.
PORT=8088

# Identifies this process in whatsapp_sessions.gateway_instance.
# Set it explicitly once you run more than one gateway — two instances
# must never open a socket for the same project.
GATEWAY_INSTANCE_ID=gateway-1

# ---- Supabase ------------------------------------------------
# Same project as the CRM. The service-role key bypasses RLS: this is
# the only process besides the CRM's server that should hold it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Encryption ----------------------------------------------
# MUST be byte-identical to the Next app's ENCRYPTION_KEY (64 hex
# chars). Both sides read and write the same encrypted session
# credentials; a mismatch makes every stored session unreadable and
# forces every customer to re-scan.
ENCRYPTION_KEY=

# ---- CRM → gateway auth ---------------------------------------
# Must match WHATSAPP_GATEWAY_TOKEN / WHATSAPP_GATEWAY_SIGNING_SECRET
# in the Next app. Generate with: openssl rand -hex 32
GATEWAY_API_TOKEN=
GATEWAY_SIGNING_SECRET=

# ---- gateway → CRM auth ---------------------------------------
# Where to deliver inbound messages, and the secret we sign them with.
# The CRM verifies this against its own WHATSAPP_GATEWAY_WEBHOOK_SECRET.
CRM_URL=https://your-crm.example.com
GATEWAY_WEBHOOK_SECRET=

# ---- Optional -------------------------------------------------
# Storage bucket for inbound media. Must match the CRM's chat bucket.
GATEWAY_MEDIA_BUCKET=chat-media
# Hard cap on a single inbound attachment. Baileys buffers media in
# memory, so this is what stops a few large videos exhausting a small VPS.
GATEWAY_MAX_MEDIA_BYTES=16777216
# Liveness stamp interval, ms.
GATEWAY_HEARTBEAT_MS=60000
# Give up reconnecting after this many consecutive failures.
GATEWAY_MAX_RECONNECT_ATTEMPTS=20

LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
