{
  "name": "wacrm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp QR session gateway for wacrm — one Baileys socket per project, credentials in Supabase.",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@supabase/supabase-js": "^2.107.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "hono": "^4.12.25",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
