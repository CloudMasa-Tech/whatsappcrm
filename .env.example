# ============================================================
# wacrm environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real values: the service-role key
# bypasses RLS entirely, and ENCRYPTION_KEY decrypts every stored
# WhatsApp credential.
#
# Full instructions: DEPLOYMENT.md
# ============================================================

# ---- Supabase (Project Settings → API) ----------------------
# These two are PUBLIC — they ship in the browser bundle, and are
# compiled in at BUILD time. Change them and you must rebuild the
# image, not just restart it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# SECRET. Bypasses RLS. Used only by server routes and the gateway.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- App ----------------------------------------------------
# The public origin, used for links and auth redirects.
NEXT_PUBLIC_SITE_URL=https://crm.example.com
NEXT_PUBLIC_APP_LOCALE=en

# 64 hex chars: openssl rand -hex 32
#
# Encrypts Meta access tokens AND QR session credentials, in both the
# web app and the gateway — the two MUST share this value. Losing or
# changing it makes every stored token undecryptable and forces every
# paired WhatsApp number to be re-scanned. Back it up separately from
# the database.
ENCRYPTION_KEY=

# ---- Meta Cloud API (cloud_api projects only) ---------------
# Meta for Developers → App Settings → Basic → App Secret.
# Verifies inbound webhook signatures; the webhook fails closed
# without it.
META_APP_SECRET=

# ---- QR gateway (qr projects only) --------------------------
# Three INDEPENDENT random secrets: openssl rand -hex 32
#
#   GATEWAY_API_TOKEN      bearer token the CRM presents
#   GATEWAY_SIGNING_SECRET HMAC over CRM → gateway request bodies
#   GATEWAY_WEBHOOK_SECRET HMAC over gateway → CRM event bodies
#
# docker-compose passes these to both services under the right names.
# Running the services separately? The web side wants the same values
# as WHATSAPP_GATEWAY_TOKEN / WHATSAPP_GATEWAY_SIGNING_SECRET /
# WHATSAPP_GATEWAY_WEBHOOK_SECRET, plus WHATSAPP_GATEWAY_URL.
GATEWAY_API_TOKEN=
GATEWAY_SIGNING_SECRET=
GATEWAY_WEBHOOK_SECRET=

# Optional. Identifies this gateway process in whatsapp_sessions.
# Set it explicitly once you run more than one instance.
GATEWAY_INSTANCE_ID=gateway-1

# Optional. Container memory ceiling for the gateway (~60-100 MB per
# active WhatsApp session on top of a ~200 MB base).
GATEWAY_MEMORY_LIMIT=2g

LOG_LEVEL=info
